# Docker Compose / MariaDB
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-secret
MYSQL_DATABASE=onlypadel
MYSQL_USER=onlypadel
MYSQL_PASSWORD=replace-with-a-long-random-secret
TZ=America/Argentina/Buenos_Aires

# Public production URL (embedded during the Next.js build)
NEXT_PUBLIC_APP_URL=https://onlypade.nanoapps.ar
PLATFORM_HOST=onlypade.nanoapps.ar
TENANT_BASE_DOMAIN=nanoapps.ar

# Initial platform owner (used idempotently by the migration job)
ONLYPADEL_SUPERADMIN_EMAIL=
ONLYPADEL_SUPERADMIN_PASSWORD=
ONLYPADEL_SUPERADMIN_NAME=NanoLabs

# Stable base64 AES key for Next.js server actions (32 random bytes)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_SUBJECT=

# WhatsApp / Meta
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=

# Cloudflare R2 Object Storage (Media / Avatars / Posts)
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://571e48d3d43463934cf910f3db847a5f.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=5cfc3e38ee877699faaa0d132dc27709
